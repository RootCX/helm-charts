{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["global", "image", "service", "persistence", "postgresql"],
  "properties": {
    "global": {
      "type": "object",
      "required": ["platform"],
      "properties": {
        "platform": {
          "type": "string",
          "enum": ["auto", "kubernetes", "openshift"]
        },
        "rootcx": {
          "type": "object",
          "properties": {
            "deploymentMode": {
              "type": "string",
              "enum": ["quickstart", "production"]
            },
            "hosts": {
              "type": "object",
              "properties": {
                "portal": {"type": "string", "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)+$"},
                "core": {"type": "string", "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)+$"}
              }
            },
            "tls": {
              "type": "object",
              "properties": {
                "secretName": {"type": "string", "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$", "maxLength": 63},
                "openshift": {
                  "type": "object",
                  "properties": {
                    "createRouterRBAC": {"type": "boolean"},
                    "routerServiceAccount": {
                      "type": "object",
                      "properties": {
                        "namespace": {"type": "string", "minLength": 1},
                        "name": {"type": "string", "minLength": 1}
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "image": {
      "type": "object",
      "required": ["repository", "pullPolicy"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string"},
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      }
    },
    "publicUrl": {
      "type": "string",
      "pattern": "^$|^https?://"
    },
    "jwtSecret": {
      "type": "string",
      "pattern": "^$|^.{32,}$"
    },
    "masterKey": {
      "type": "string",
      "pattern": "^$|^[a-fA-F0-9]{64}$"
    },
    "disablePasswordLogin": {
      "type": "string",
      "enum": ["true", "false"]
    },
    "ai": {
      "type": "object",
      "required": ["openai"],
      "properties": {
        "openai": {
          "type": "object",
          "required": ["baseUrl"],
          "properties": {
            "baseUrl": {
              "type": "string",
              "pattern": "^$|^https?://"
            }
          }
        }
      }
    },
    "service": {
      "type": "object",
      "required": ["type", "port"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["ClusterIP", "NodePort", "LoadBalancer"]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "route": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "host": {"type": "string"},
        "tls": {
          "type": "object",
          "properties": {
            "termination": {"type": "string", "enum": ["edge", "reencrypt", "passthrough"]},
            "insecureEdgeTerminationPolicy": {"type": "string", "enum": ["Allow", "Disable", "Redirect"]},
            "externalCertificateSecretName": {"type": "string", "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$", "maxLength": 63},
            "createRouterRBAC": {"type": "boolean"}
          }
        }
      }
    },
    "persistence": {
      "type": "object",
      "required": ["enabled", "accessMode", "size"],
      "properties": {
        "enabled": {"type": "boolean"},
        "accessMode": {
          "type": "string",
          "enum": ["ReadWriteOnce", "ReadWriteMany"]
        },
        "size": {
          "type": "string",
          "pattern": "^[0-9]+(Ei|Pi|Ti|Gi|Mi|Ki)$"
        }
      }
    },
    "postgresql": {
      "type": "object",
      "required": ["enabled", "terminationGracePeriodSeconds", "image", "auth", "persistence"],
      "properties": {
        "enabled": {"type": "boolean"},
        "terminationGracePeriodSeconds": {
          "type": "integer",
          "minimum": 30,
          "maximum": 300
        },
        "image": {
          "type": "object",
          "required": ["repository", "tag", "pullPolicy"],
          "properties": {
            "repository": {"type": "string", "minLength": 1},
            "tag": {"type": "string", "minLength": 1},
            "pullPolicy": {
              "type": "string",
              "enum": ["Always", "IfNotPresent", "Never"]
            }
          }
        },
        "auth": {
          "type": "object",
          "required": ["username", "database"],
          "properties": {
            "username": {
              "type": "string",
              "pattern": "^[a-zA-Z_][a-zA-Z0-9_]{0,62}$"
            },
            "database": {
              "type": "string",
              "pattern": "^[a-zA-Z_][a-zA-Z0-9_]{0,62}$"
            },
            "password": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]*$"
            }
          }
        },
        "extraDatabases": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z_][a-zA-Z0-9_]{0,62}$"
          }
        },
        "persistence": {
          "type": "object",
          "required": ["enabled", "accessMode", "size"],
          "properties": {
            "enabled": {"type": "boolean"},
            "accessMode": {
              "type": "string",
              "enum": ["ReadWriteOnce", "ReadWriteMany"]
            },
            "size": {
              "type": "string",
              "pattern": "^[0-9]+(Ei|Pi|Ti|Gi|Mi|Ki)$"
            }
          }
        }
      }
    }
  }
}
