{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["global", "instance", "bootstrap", "email", "image", "service", "core"],
  "properties": {
    "global": {
      "type": "object",
      "required": ["platform", "rootcx"],
      "properties": {
        "platform": {
          "type": "string",
          "enum": ["auto", "kubernetes", "openshift"]
        },
        "rootcx": {
          "type": "object",
          "required": ["portalPublicUrl", "corePublicUrl", "oidcIssuer", "oidcClientId"],
          "properties": {
            "deploymentMode": {
              "type": "string",
              "enum": ["quickstart", "production"]
            },
            "portalPublicUrl": {"type": "string", "pattern": "^https?://"},
            "corePublicUrl": {"type": "string", "pattern": "^https?://"},
            "oidcIssuer": {"type": "string", "pattern": "^https?://"},
            "oidcClientId": {"type": "string", "minLength": 1},
            "oidcClientSecret": {"type": "string"},
            "hosts": {
              "type": "object",
              "required": ["portal", "core"],
              "properties": {
                "portal": {"type": "string", "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)+$"},
                "core": {"type": "string", "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)+$"}
              }
            },
            "tls": {
              "type": "object",
              "required": ["secretName"],
              "properties": {
                "secretName": {"type": "string", "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$", "maxLength": 63},
                "openshift": {
                  "type": "object",
                  "required": ["createRouterRBAC", "routerServiceAccount"],
                  "properties": {
                    "createRouterRBAC": {"type": "boolean"},
                    "routerServiceAccount": {
                      "type": "object",
                      "required": ["namespace", "name"],
                      "properties": {
                        "namespace": {"type": "string", "minLength": 1},
                        "name": {"type": "string", "minLength": 1}
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "instance": {
      "type": "object",
      "required": ["name", "ref"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 100},
        "ref": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
          "maxLength": 63
        }
      }
    },
    "bootstrap": {
      "type": "object",
      "required": ["adminEmail"],
      "properties": {
        "adminEmail": {
          "type": "string",
          "pattern": "^[^@[:space:]]+@[^@[:space:]]+\\.[^@[:space:]]+$"
        }
      }
    },
    "email": {
      "type": "object",
      "required": ["enabled", "from", "smtp"],
      "properties": {
        "enabled": {"type": "boolean"},
        "from": {"type": "string"},
        "smtp": {
          "type": "object",
          "required": ["host", "port", "secure", "requireTls", "username", "password"],
          "properties": {
            "host": {"type": "string"},
            "port": {"type": "integer", "minimum": 1, "maximum": 65535},
            "secure": {"type": "boolean"},
            "requireTls": {"type": "boolean"},
            "username": {"type": "string"},
            "password": {"type": "string"}
          }
        }
      }
    },
    "replicaCount": {"type": "integer", "minimum": 1},
    "image": {
      "type": "object",
      "required": ["repository", "tag", "pullPolicy"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string", "minLength": 1},
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      }
    },
    "auth": {
      "type": "object",
      "required": ["secret"],
      "properties": {
        "secret": {
          "type": "string",
          "pattern": "^$|^.{32,}$"
        },
        "trustHost": {"type": "boolean"}
      }
    },
    "oidc": {
      "type": "object",
      "properties": {
        "signingKey": {"type": "string"}
      }
    },
    "service": {
      "type": "object",
      "required": ["type", "port"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["ClusterIP", "NodePort", "LoadBalancer"]
        },
        "port": {"type": "integer", "minimum": 1, "maximum": 65535}
      }
    },
    "core": {
      "type": "object",
      "properties": {
        "existingSecret": {"type": "string"},
        "jwtSecret": {"type": "string", "pattern": "^$|^.{32,}$"},
        "masterKey": {"type": "string", "pattern": "^$|^[0-9a-fA-F]{64}$"}
      }
    }
  }
}
